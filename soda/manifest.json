{
  "id": "com.sodamusic.source",
  "name": "@plugin.name",
  "versionCode": 10,
  "versionName": "0.5.2",
  "author": "Replica0110",
  "description": "@plugin.description",
  "apiVersion": 5,
  "includeDirs": [
    "lib"
  ],
  "icon": "icon.png",
  "entry": "source.js",
  "capabilities": [
    "searchSongs",
    "getLyrics",
    "searchCovers"
  ],
  "configFields": [
    {
      "key": "auth_notice",
      "title": "@config.auth_notice.title",
      "group": "@group.request",
      "type": "markdown",
      "defaultValue": "@config.auth_notice.content"
    },
    {
      "key": "cookies",
      "title": "@config.cookies.title",
      "group": "@group.auth",
      "type": "password",
      "defaultValue": ""
    }
  ],
  "minHostApiVersion": 4,
  "i18n": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json",
      "zh-Hans": "locales/zh-Hans.json",
      "zh-Hant": "locales/zh-Hant.json"
    }
  }
}
