{
  "id": "com.spotify.source",
  "name": "Spotify",
  "versionCode": 1,
  "versionName": "1.0.0",
  "author": "BingoKingo",
  "description": "@plugin.description",
  "apiVersion": 5,
  "minHostApiVersion": 4,
  "includeDirs": [
    "lib"
  ],
  "icon": "icon.png",
  "entry": "source.js",
  "capabilities": [
    "searchSongs",
    "getLyrics",
    "searchCovers"
  ],
  "configFields": [
    {
      "key": "sp_dc",
      "title": "@config.sp_dc.title",
      "summary": "@config.sp_dc.summary",
      "type": "password",
      "defaultValue": ""
    }
  ],
  "i18n": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json",
      "zh-Hans": "locales/zh-Hans.json",
      "zh-Hant": "locales/zh-Hant.json"
    }
  }
}
