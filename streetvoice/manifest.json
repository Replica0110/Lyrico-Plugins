{
  "id": "com.streetvoice.source",
  "name": "StreetVoice",
  "versionCode": 1,
  "versionName": "1.0.0",
  "author": "BingoKingo",
  "description": "@plugin.description",
  "apiVersion": 5,
  "minHostApiVersion": 4,
  "includeDirs": [
    "lib"
  ],
  "icon": "icon.png",
  "entry": "source.js",
  "capabilities": [
    "searchSongs",
    "getLyrics",
    "searchCovers"
  ],
  "configFields": [
    {
      "key": "cover_size",
      "title": "@config.cover_size.title",
      "summary": "@config.cover_size.summary",
      "group": "@group.cover",
      "type": "dropdown",
      "required": true,
      "defaultValue": "original",
      "options": [
        {
          "value": "original",
          "label": "@config.cover_size.option.original"
        },
        {
          "value": "sv",
          "label": "@config.cover_size.option.sv"
        },
        {
          "value": "500",
          "label": "500 × 500"
        },
        {
          "value": "1000",
          "label": "1000 × 1000"
        }
      ]
    }
  ],
  "i18n": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json",
      "zh-Hans": "locales/zh-Hans.json",
      "zh-Hant": "locales/zh-Hant.json"
    }
  }
}
