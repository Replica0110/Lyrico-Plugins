{
  "id": "com.kugou.source",
  "name": "@plugin.name",
  "versionCode": 9,
  "versionName": "0.5.0",
  "author": "Replica0110",
  "description": "@plugin.description",
  "apiVersion": 5,
  "includeDirs": [
    "lib"
  ],
  "entry": "source.js",
  "icon": "icon.png",
  "capabilities": [
    "searchSongs",
    "getLyrics",
    "searchCovers"
  ],
  "minHostApiVersion": 4,
  "i18n": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json",
      "zh-Hans": "locales/zh-Hans.json",
      "zh-Hant": "locales/zh-Hant.json"
    }
  },
  "configFields": [
    {
      "key": "metadata_details",
      "title": "@config.metadata_details.title",
      "summary": "@config.metadata_details.summary",
      "type": "switch",
      "defaultValue": "true"
    }
  ]
}
