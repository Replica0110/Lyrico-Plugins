{
  "id": "com.musicbrainz.source",
  "name": "MusicBrainz",
  "versionCode": 5,
  "versionName": "1.2.1",
  "author": "X2ISPANDA",
  "description": "@plugin.description",
  "apiVersion": 4,
  "entry": "source.js",
  "includeDirs": [
    "lib"
  ],
  "icon": "icon.png",
  "capabilities": [
    "searchSongs",
    "searchCovers"
  ],
  "configFields": [
    {
      "key": "enrich",
      "title": "@config.enrich.title",
      "summary": "@config.enrich.summary",
      "group": "@group.search",
      "type": "switch",
      "defaultValue": "false"
    },
    {
      "key": "enrich_limit",
      "title": "@config.enrich_limit.title",
      "summary": "@config.enrich_limit.summary",
      "group": "@group.search",
      "type": "number",
      "defaultValue": "5"
    },
    {
      "key": "timeout",
      "title": "@config.timeout.title",
      "summary": "@config.timeout.summary",
      "group": "@group.request",
      "type": "number",
      "defaultValue": "20"
    }
  ],
  "minHostApiVersion": 4,
  "i18n": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json",
      "zh-Hans": "locales/zh-Hans.json",
      "zh-Hant": "locales/zh-Hant.json"
    }
  }
}
